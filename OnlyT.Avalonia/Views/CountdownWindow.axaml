<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OnlyT.Avalonia.ViewModels"
        xmlns:loc="using:OnlyT.Avalonia.Services.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="300"
        x:Class="OnlyT.Avalonia.Views.CountdownWindow"
        x:DataType="vm:CountdownViewModel"
        Title="{loc:Localize COUNTDOWN_SECTION}"
        Width="500" Height="300"
        WindowStartupLocation="CenterScreen"
        Background="{Binding WindowBackground}"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent">

    <Design.DataContext>
        <vm:CountdownViewModel/>
    </Design.DataContext>

    <Grid>
        <Border Background="{Binding BorderBackground}"
                CornerRadius="20"
                Margin="10"
                Padding="20">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{loc:Localize MSG_MEETING_STARTS_IN}"
                           FontSize="24"
                           Foreground="{DynamicResource MaterialBodyLightBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <!-- Countdown Display -->
                <Viewbox Grid.Row="1" Margin="20">
                    <TextBlock Text="{Binding CountdownDisplay}"
                               FontSize="120"
                               FontWeight="Bold"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="{Binding CountdownColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Viewbox>

                <!-- Close Button -->
                <Button Grid.Row="2"
                        Content="{loc:Localize BTN_CLOSE}"
                        HorizontalAlignment="Center"
                        Padding="20,8"
                        Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>
    </Grid>

</Window>
