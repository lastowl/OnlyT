<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OnlyT.Avalonia.ViewModels"
        xmlns:clock="using:OnlyT.Avalonia.Controls.AnalogueClock"
        xmlns:local="using:OnlyT.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="OnlyT.Avalonia.Views.TimerOutputWindow"
        x:DataType="vm:TimerOutputViewModel"
        Title="OnlyT Timer"
        Icon="/Assets/icon.ico"
        Width="800" Height="600"
        WindowState="Normal"
        Cursor="{Binding MousePointer}"
        Background="{Binding BackgroundColor}">

    <Design.DataContext>
        <vm:TimerOutputViewModel/>
    </Design.DataContext>

    <Border CornerRadius="20"
            Margin="5"
            BorderBrush="Beige"
            BorderThickness="{Binding FrameBorderThickness}">

        <Grid RowDefinitions="*,Auto">

            <!-- Row 0: Main display area — side-by-side columns matching
                 the WPF TimerOutputWindow layout. The slider in Settings
                 controls the column split via AnalogueClockWidthPercent. -->
            <Grid Grid.Row="0">

                <!-- BOTH (horizontal): side-by-side analogue (left) + digital (right).
                     Matches WPF layout. Slider controls the column split. -->
                <Grid IsVisible="{Binding ShowBothClocksHorizontal}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding AnalogueClockWidthPercent, Converter={x:Static local:PercentToGridLengthConverter.Instance}}"/>
                        <ColumnDefinition Width="{Binding AnalogueClockWidthPercent, Converter={x:Static local:PercentToGridLengthConverter.ComplementInstance}}"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Margin="10"
                             Opacity="{Binding FlashOpacity}"
                             Stretch="Uniform"
                             StretchDirection="Both">
                        <clock:ClockControl IsFlat="{Binding IsClockFlat}"
                                            IsRunning="{Binding IsClockRunning}"
                                            DurationSector="{Binding DurationSector}"
                                            DigitalTimeFormat24Hours="{Binding DigitalTimeFormat24Hours}"
                                            DigitalTimeFormatShowLeadingZero="{Binding DigitalTimeFormatShowLeadingZero}"
                                            DigitalTimeFormatAMPM="{Binding DigitalTimeFormatAMPM}"
                                            Width="500" Height="500"/>
                    </Viewbox>

                    <Viewbox Grid.Column="1"
                             Margin="10"
                             Opacity="{Binding FlashOpacity}"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="200"
                                   FontWeight="Bold"
                                   FontFamily="Consolas,Courier New,monospace"
                                   Foreground="{Binding TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Grid>

                <!-- BOTH (vertical): analogue on top, digital below.
                     Avalonia default. Better for portrait displays. -->
                <Grid RowDefinitions="3*,2*"
                      IsVisible="{Binding ShowBothClocksVertical}">
                    <Viewbox Grid.Row="0"
                             Margin="10"
                             Opacity="{Binding FlashOpacity}"
                             Stretch="Uniform"
                             StretchDirection="Both">
                        <clock:ClockControl IsFlat="{Binding IsClockFlat}"
                                            IsRunning="{Binding IsClockRunning}"
                                            DurationSector="{Binding DurationSector}"
                                            DigitalTimeFormat24Hours="{Binding DigitalTimeFormat24Hours}"
                                            DigitalTimeFormatShowLeadingZero="{Binding DigitalTimeFormatShowLeadingZero}"
                                            DigitalTimeFormatAMPM="{Binding DigitalTimeFormatAMPM}"
                                            Width="500" Height="500"/>
                    </Viewbox>

                    <Viewbox Grid.Row="1"
                             Margin="10,0,10,10"
                             Opacity="{Binding FlashOpacity}"
                             Stretch="Uniform"
                             StretchDirection="DownOnly">
                        <TextBlock Text="{Binding TimeDisplay}"
                                   FontSize="200"
                                   FontWeight="Bold"
                                   FontFamily="Consolas,Courier New,monospace"
                                   Foreground="{Binding TextColor}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Grid>

                <!-- DIGITAL ONLY: full size -->
                <Viewbox IsVisible="{Binding ShowDigitalClockOnly}"
                         Opacity="{Binding FlashOpacity}">
                    <TextBlock Text="{Binding TimeDisplay}"
                               FontSize="200"
                               FontWeight="Bold"
                               FontFamily="Consolas,Courier New,monospace"
                               Foreground="{Binding TextColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Viewbox>

                <!-- ANALOGUE ONLY: full size -->
                <Viewbox IsVisible="{Binding ShowAnalogueClockOnly}"
                         Margin="20"
                         Opacity="{Binding FlashOpacity}"
                         Stretch="Uniform"
                         StretchDirection="Both">
                    <clock:ClockControl IsFlat="{Binding IsClockFlat}"
                                        IsRunning="{Binding IsClockRunning}"
                                        DurationSector="{Binding DurationSector}"
                                        DigitalTimeFormat24Hours="{Binding DigitalTimeFormat24Hours}"
                                        DigitalTimeFormatShowLeadingZero="{Binding DigitalTimeFormatShowLeadingZero}"
                                        DigitalTimeFormatAMPM="{Binding DigitalTimeFormatAMPM}"
                                        Width="500" Height="500"/>
                </Viewbox>

            </Grid>

            <!-- Row 1: Time of day. Only shown when the main display is
                 showing the timer; hidden when it's already the wall clock. -->
            <TextBlock Grid.Row="1"
                       Text="{Binding CurrentTimeOfDay}"
                       IsVisible="{Binding IsTimeOfDayVisible}"
                       FontSize="48"
                       FontFamily="Consolas,Courier New,monospace"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

        </Grid>
    </Border>

</Window>
