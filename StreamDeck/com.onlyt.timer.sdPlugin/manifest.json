{
    "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
    "UUID": "com.onlyt.timer",
    "Name": "OnlyT",
    "Description": "Control the OnlyT meeting timer: start and stop talk timers, move to the next talk and ring the bell",
    "Author": "OnlyT",
    "Version": "2.5.0.11",
    "Category": "OnlyT",
    "CategoryIcon": "images/category-icon",
    "Icon": "images/plugin-icon",
    "URL": "https://github.com/lastowl/OnlyT",
    "CodePath": "plugin.js",
    "Nodejs": {
        "Version": "24"
    },
    "PropertyInspectorPath": "pi.html",
    "OS": [
        {
            "Platform": "mac",
            "MinimumVersion": "12"
        },
        {
            "Platform": "windows",
            "MinimumVersion": "10"
        }
    ],
    "Software": {
        "MinimumVersion": "7.1"
    },
    "SDKVersion": 2,
    "Actions": [
        {
            "Name": "Start Timer",
            "UUID": "com.onlyt.timer.start",
            "Icon": "images/actions/start",
            "Tooltip": "Start the timer for a talk",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "images/start-icon",
                    "Title": "Start"
                }
            ]
        },
        {
            "Name": "Stop Timer",
            "UUID": "com.onlyt.timer.stop",
            "Icon": "images/actions/stop",
            "Tooltip": "Stop the running timer",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "images/stop-icon",
                    "Title": "Stop"
                }
            ]
        },
        {
            "Name": "Start/Stop Timer",
            "UUID": "com.onlyt.timer.toggle",
            "Icon": "images/actions/toggle",
            "Tooltip": "Stop the running timer, or start one when none is running",
            "Controllers": ["Keypad"],
            "DisableAutomaticStates": true,
            "States": [
                {
                    "Image": "images/start-icon",
                    "Title": "Start"
                },
                {
                    "Image": "images/stop-icon",
                    "Title": "Stop"
                }
            ]
        },
        {
            "Name": "Ring Bell",
            "UUID": "com.onlyt.timer.bell",
            "Icon": "images/actions/bell",
            "Tooltip": "Ring OnlyT's bell",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "images/bell-icon",
                    "Title": "Bell"
                }
            ]
        },
        {
            "Name": "Next Talk",
            "UUID": "com.onlyt.timer.next",
            "Icon": "images/actions/next",
            "Tooltip": "Stop the running talk and start the next one",
            "Controllers": ["Keypad"],
            "States": [
                {
                    "Image": "images/next-icon",
                    "Title": "Next"
                }
            ]
        }
    ]
}
